	<add key="LineCamera.AnalogGain" value="1" />
	<add key="XyLocking.ShiftDB" value="C:\versions\dev\HemoScope\Data\stab_shifts_100k.csv"/>

	<add key='DepthOfFocus' value='16' />
	<add key='XyLocking.FrameSelectionRate' value='8' />

	<!-- Camera Alignment Sequence -->
	<add key="CameraAlignment.NRuns" value="10" />
	<add key="CameraAlignment.MovementRange" value="0.1" />
	
	<!-- Led Controller settings: LedController.Device and LedController.Channels are now part of
	     Arduino.Pins (Controller / ControllerChannel and the power fields, per pin).
	     The channel names set in e6b5020 ("Kohler 450nm" / "Kohler 410nm") live there, on pins 5 and 6. -->


</appSettings>
