<?xml version="1.0" encoding="utf-8" ?>
<!--
  ============================================================================
  DO NOT EDIT THIS FILE
  ============================================================================
  This file is a COLD-START FALLBACK ONLY. Edits made here are IGNORED at
  runtime as soon as HemoScope can reach the cloud config repo.

  Edit the live version in:
      https://github.com/LiteBC/Hemoscope-config

  Commit and push there. The bench picks up the change at the next launch
  (look for [ConfigSync] lines in HemoScope.log).

  This bundled copy exists only so the app can still boot when:
    - it is a fresh install with no local cache yet, AND
    - the cloud repo is unreachable (offline / GitHub down).
  ============================================================================
-->
<appSettings>
	<add key="Version.Hardware" value="VB3002" />

	<!-- Astro 1-->
	<add key="BacklightDeviceAstroPort" value="2" />
	<add key="LineCamDeviceAstroPort" value="1" />
	<add key="MotorDeviceAstroPort" value="4" />
	<add key="RotationDeviceAstroPort" value="5" />

	<!-- Astro 2-->
	<add key="WideCamDeviceAstroPort" value="-1" />

	<add key="WideCamera.BaslerUsb.Aperture" value="5.6" />
	<add key="WideCamera.BaslerCxp.Aperture" value="5.6" />
	<add key="BacklightDevice" value="Arduino" />
	<!-- BacklightWavelengths / ConstantBacklightWavelengths are now part of Arduino.Pins (see below). -->

	<add key="Basler.Camera0.Model" value="USB" />
	<add key="Basler.Camera1.Model" value="Cxp" />
	<add key="MainLed0" value="10" />
	<add key="MainLed1" value="9" />

	<!-- 09.03.2026 -->
	<add key="Global.LinePixelSize" value="0.116e-3" />
	<add key="LineCamera.PixelSlope" value="-4.41e-9" />
	<add key="Global.MaxSpeed" value="20" />
	<add key="WideCamera.BaslerUsb.PixelSize" value="0.863e-3" />
	<add key="WideCamera.BaslerCxp.PixelSize" value="0.534e-3" />

	<!-- 24 feb 2026 -->
	<add key="WideCamera.UsbCamera.MotorCoordinateMatrix" value="[[0.99990,0.01425],[-0.01425,0.99990]]"/>
	<add key="LineCamDevice" value="OctoPlus" />

	<!-- 23 jul 2026 -->
	<add key="WideCamera.UsbCamera.LineInWideCalibration" value="{cx:875,cy:586,r:-14,a:9,angle:-159.5}" />
	<add key="WideCamera.CxpCamera.LineInWideCalibration" value="{cx:1309,cy:904,r:-25,a:23,angle:-161}" />

	<add key="MotorDevice" value="Zaber" />
	<add key="RotationDevice" value="Elliptec" />
	<add key="RotationDeviceDirection" value="-1" />
	<add key="WaterSensor.Threshold" value="0" />
	<add key="WideCamDevice" value="Basler" />
	<add key="WideCamDevice0" value="Basler" />
	<add key="WideCamDevice0.TriggerPin" value="7" />
	<add key="WideCamDevice1" value="Basler" />
	<add key="WideCamDevice1.TriggerPin" value="8" />
	<add key="Default.Arduino.LedColorsPattern" value="[[1,5,11,12],[2,12],[3,12]]" />
	<add key="WideZScan.Arduino.LedColorsPattern" value="[[1,5,11,12],[2,12],[3,12],[1,6,11,12],[2,12],[3,12]]" />
	<add key="Basler.Camera0.UserSet" value="UserSet1" />
	<add key="Basler.Camera1.UserSet" value="UserSet1" />

	<!--
		Arduino.Pins - one entry per Arduino pin, keyed by pin number. This is the single description of
		what each pin drives; it replaces WideCamera.Arduino.PinRoles, LedController.Device,
		LedController.Channels, LedPositionsWide, IlluminationWide, BacklightWavelengths and
		ConstantBacklightWavelengths, all of which described these same pins from different angles.

		  Role              - Led | CameraTrigger                     (default Led)
		  Connected         - false when nothing is wired to this pin; the LED Pattern tab then leaves the
		                      column out of its table (default true). A pin the active pattern uses is
		                      shown regardless, so hiding it can never silently drop it from the pattern.
		  Camera            - CXP | USB: the camera this pin fires, or that this LED illuminates
		  LedGroup          - which physical LED this pin belongs to within its camera. Pins sharing a
		                      Camera and LedGroup are ONE physical LED wired across several channels
		                      (the old led_groups:[[1,2,3]]). The number also fixes group order, which
		                      callers index into, so keep it 0-based and contiguous per camera.
		  Controller        - Mightex | Gardasoft: the LED controller driving this pin
		  ControllerChannel - the channel this pin occupies on that controller
		  Name              - free-text label, shown in the GUI and logs
		  State             - Constant | Triggered
		  TriggerType       - None | HighEdge | LowEdge               (required when Triggered)
		  Power / MaxPower  - drive current and this LED's ceiling, mA
		  LedDelayUs        - trigger edge to LED on, us              (optional, default 0)
		  LedOnTimeUs       - LED on time, us                         (required when Triggered)
		  Position          - was LedPositionsWide
		  Illumination      - was IlluminationWide
		  Wavelength        - was BacklightWavelengths, nm
		  Constant          - was ConstantBacklightWavelengths, nm

		Gardasoft has no driver in HemoScope yet: pins 1-3 are described here so the wiring is recorded,
		and the app logs that it is not driving them.
	-->
	<add key="Arduino.Pins" value='{
		1:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LB", Illumination: "OBLIQUE", Wavelength: "530" },
		2:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LC", Illumination: "OBLIQUE", Wavelength: "530" },
		3:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LT", Illumination: "OBLIQUE", Wavelength: "530" },
		4:  { Role: "Led", Connected: false, Position: "MT", Illumination: "OBLIQUE", Wavelength: "530" },
		5:  { Role: "Led", Camera: "USB", LedGroup: 0, Controller: "Mightex", ControllerChannel: 1, Name: "Kohler 450nm",
		      State: "Triggered", TriggerType: "HighEdge", Power: 1000, MaxPower: 3500, LedDelayUs: 0, LedOnTimeUs: 1000,
		      Position: "RT", Illumination: "Kohler", Wavelength: "450" },
		6:  { Role: "Led", Camera: "USB", LedGroup: 1, Controller: "Mightex", ControllerChannel: 2, Name: "Kohler 410nm",
		      State: "Triggered", TriggerType: "HighEdge", Power: 2200, MaxPower: 3500, LedDelayUs: 0, LedOnTimeUs: 1000,
		      Position: "RC", Illumination: "Kohler", Wavelength: "410" },
		7:  { Role: "Led", Connected: false, Position: "RB", Illumination: "OBLIQUE", Wavelength: "530" },
		8:  { Role: "Led", Connected: false, Position: "MB", Illumination: "OBLIQUE", Wavelength: "530" },
		9:  { Role: "Led", Connected: false, Position: "center", Illumination: "OBLIQUE", Wavelength: "530" },
		10: { Role: "Led", Connected: false, Position: "Even_Ilumination", Illumination: "Kohler", Wavelength: "530", Constant: "452" },
		11: { Role: "CameraTrigger", Camera: "USB" },
		12: { Role: "CameraTrigger", Camera: "CXP" }
	}' />
	<add key="LensDevice" value="dummy" />
	<add key="LensDevice.DefaultFocus" value="4133" />
	<add key="LensDevice.DefaultIris" value="402" />
	<add key="Basler.TimeCorrection.Factor" value="0.999928" />
	<!-- 16.12.2025 -->
	<add key="Basler.TimeCorrection.OffsetMs" value="0" />
	<!-- 23.12.2025 -->
	<add key="Zaber.TimeCorrection.Factor" value="0.999988" />
	<!-- 16.12.2025 -->
	<add key="Zaber.TimeCorrection.OffsetMs" value="0" />
	<!-- 23.12.2025 -->
	<add key="Zaber.SettlePeriodMs" value="10" />
	<add key="Zaber.SettleTolerance" value="0.003" />
	<add key="Zaber.Stages" value='{x:[0,1], y:[0,2], z:[0,3]}'/>
