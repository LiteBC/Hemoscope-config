<?xml version="1.0" encoding="utf-8" ?>
<!--
  ============================================================================
  DO NOT EDIT THIS FILE
  ============================================================================
  This file is a COLD-START FALLBACK ONLY. Edits made here are IGNORED at
  runtime as soon as HemoScope can reach the cloud config repo.

  Edit the live version in:
      https://github.com/LiteBC/Hemoscope-config

  Commit and push there. The bench picks up the change at the next launch
  (look for [ConfigSync] lines in HemoScope.log).

  This bundled copy exists only so the app can still boot when:
    - it is a fresh install with no local cache yet, AND
    - the cloud repo is unreachable (offline / GitHub down).
  ============================================================================
-->
<appSettings>
	<add key="Version.Hardware" value="V2.0.4" />

	<!-- Astro 1-->
	<add key="BacklightDeviceAstroPort" value="2" />
	<add key="LineCamDeviceAstroPort" value="1" />
	<add key="MotorDeviceAstroPort" value="4" />
	<add key="RotationDeviceAstroPort" value="5" />

	<!-- Astro 2-->
	<add key="WideCamDeviceAstroPort" value="-1" />

	<add key="WideCamera.BaslerUsb.Aperture" value="5.6" />
	<add key="WideCamera.BaslerCxp.Aperture" value="5.6" />
	<add key="BacklightDevice" value="Arduino" />
	<!-- BacklightWavelengths / ConstantBacklightWavelengths are now part of Arduino.Pins (see below). -->

	<add key="Basler.Camera0.Model" value="USB" />
	<add key="Basler.Camera1.Model" value="Cxp" />
	<add key="MainLed0" value="10" />
	<add key="MainLed1" value="9" />
	<!--<add key="Global.LinePixelSize" value="0.12e-3" />-->
	<add key="Global.LinePixelSize" value="0.120e-3" />
	<add key="LineCamera.PixelSlope" value="-4.55e-9" />
	<add key="Global.MaxSpeed" value="20" />
	<add key="WideCamera.BaslerUsb.PixelSize" value="0.892e-3" />
	<!-- 16.12.2025 -->
	<add key="WideCamera.BaslerCxp.PixelSize" value="0.525e-3" />

	<!--<add key="WideCamera.UsbCamera.MotorCoordinateMatrix" value="[[0.999536,0.030469],[-0.030469,0.999536]]"/>-->
	<add key="WideCamera.UsbCamera.MotorCoordinateMatrix" value="[[0.999973,0.007388],[-0.007388,0.999973]]"/>
	<add key="LineCamDevice" value="OctoPlus" />
	<!--<add key="WideCamera.UsbCamera.LineInWideCalibration" value="{cx:713,cy:448,r:-6,a:-15,angle:-172}" /> before 08.02-->
	<!--<add key="WideCamera.UsbCamera.LineInWideCalibration" value="{cx:691,cy:433,r:-6,a:-28,angle:-172}" />-->
	<!---><add key="WideCamera.UsbCamera.LineInWideCalibration" value="{cx:723,cy:494,r:-6,a:-15,angle:-172}" />-->
	<!-- 13.01.2026 -->
	<!-- 13.01.2026 -->

	<add key="WideCamera.UsbCamera.LineInWideCalibration" value="{cx:758,cy:279,r:-5,a:-15,angle:-174}" />
	<add key="WideCamera.CxpCamera.LineInWideCalibration" value="{cx:1179,cy:315,r:-8,a:-21,angle:-174}" />

	<add key="MotorDevice" value="Zaber" />
	<add key="RotationDevice" value="Elliptec" />
	<add key="RotationDeviceDirection" value="-1" />
	<add key="WaterSensor.Threshold" value="950" />
	<add key="WideCamDevice" value="Basler" />
	<add key="WideCamDevice0" value="Basler" />
	<add key="WideCamDevice0.TriggerPin" value="7" />
	<add key="WideCamDevice1" value="Basler" />
	<add key="WideCamDevice1.TriggerPin" value="8" />

	<add key="Default.Arduino.LedColorsPattern" value="[[1,5,11,12],[1,12],[1,12]]" />
	<add key="WideZScan.Arduino.LedColorsPattern" value="[[1,5,11,12],[1,12],[1,12],[1,6,11,12],[1,12],[1,12]]" />

	<add key="Basler.Camera0.UserSet" value="UserSet1" />
	<add key="Basler.Camera1.UserSet" value="UserSet1" />

	<!--
		Arduino.Pins - one entry per Arduino pin, keyed by pin number. This is the single description of
		what each pin drives; it replaces WideCamera.Arduino.PinRoles, LedController.Device,
		LedController.Channels, LedPositionsWide, IlluminationWide, BacklightWavelengths and
		ConstantBacklightWavelengths, all of which described these same pins from different angles.
		See Hemoscope1.config for the full field reference. Connected:false marks a pin with nothing
		wired to it, which the LED Pattern tab leaves out of its table.

		Note: this bench previously split its position and illumination maps into LedPositionsWide0/1 and
		IlluminationWide0/1. Nothing read those suffixed keys, so saved captures recorded every LED as
		"Unknown"; folding them in here fixes that.
	-->
	<add key="Arduino.Pins" value='{
		1:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LB", Illumination: "OBLIQUE", Wavelength: "530" },
		2:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LC", Illumination: "OBLIQUE", Wavelength: "530" },
		3:  { Role: "Led", Camera: "CXP", LedGroup: 0, Controller: "Gardasoft", Position: "LT", Illumination: "OBLIQUE", Wavelength: "530" },
		4:  { Role: "Led", Connected: false, Position: "MT", Illumination: "OBLIQUE", Wavelength: "530" },
		5:  { Role: "Led", Camera: "USB", LedGroup: 0, Controller: "Mightex", ControllerChannel: 1, Name: "Kohler 450nm",
		      State: "Triggered", TriggerType: "HighEdge", Power: 1000, MaxPower: 3500, LedDelayUs: 0, LedOnTimeUs: 1000,
		      Position: "RT", Illumination: "Kohler", Wavelength: "450" },
		6:  { Role: "Led", Camera: "USB", LedGroup: 1, Controller: "Mightex", ControllerChannel: 2, Name: "Kohler 410nm",
		      State: "Triggered", TriggerType: "HighEdge", Power: 2200, MaxPower: 3500, LedDelayUs: 0, LedOnTimeUs: 1000,
		      Position: "RC", Illumination: "Kohler", Wavelength: "410" },
		7:  { Role: "Led", Connected: false, Position: "RB", Illumination: "OBLIQUE", Wavelength: "530" },
		8:  { Role: "Led", Connected: false, Position: "MB", Illumination: "OBLIQUE", Wavelength: "530" },
		9:  { Role: "Led", Connected: false, Position: "center", Illumination: "OBLIQUE", Wavelength: "530" },
		10: { Role: "Led", Connected: false, Position: "Even_Ilumination", Illumination: "Kohler" },
		11: { Role: "CameraTrigger", Camera: "USB" },
		12: { Role: "CameraTrigger", Camera: "CXP" }
	}' />
	<add key="LensDevice" value="dummy" />
	<add key="LensDevice.DefaultFocus" value="4133" />
	<add key="LensDevice.DefaultIris" value="402" />
	<add key="Basler.TimeCorrection.Factor" value="0.999901" /><!-- 20.07.2026 -->
	<add key="Basler.TimeCorrection.OffsetMs" value="0" /><!-- 16.12.2025 -->
	<add key="Zaber.TimeCorrection.Factor" value="0.999958" /><!-- 20.07.2026 -->
	<add key="Zaber.TimeCorrection.OffsetMs" value="0" /><!-- 16.12.2025 -->
	<add key="Zaber.SettlePeriodMs" value="10" />
	<add key="Zaber.SettleTolerance" value="0.003" />
	<add key="Zaber.Stages" value='{x:[0,1], y:[0,2], z:[0,3]}'/>
	<add key="Arduino.TimeCorrection.Factor" value="0.999973" /><!-- 16.12.2025 -->
	<add key="Arduino.TimeCorrection.OffsetMs" value="0" /> <!-- to be measured -->
	<add key="LineCamera.TimeCorrection.Factor" value="0.999977" /><!-- 24.05.2026 -->

	<add key="WideCamera.CxpCamera.DefaultExposure" value="500" />

	<!--add key="WideCam.FrameRateLimit" value="166" /-->
	<!-- uncomment this to enable frame rate limiter -->

	<!-- Motor range -->
	<add key="X.Minimum" value="0" />
	<add key="X.Maximum" value="5" />
	<add key="X.Polarity" value="-1" />
	<add key="X.Parking" value="2.5" />
	<add key="X.StepSize" value="0.1" />
	<add key="Y.Minimum" value="0" />
	<add key="Y.Maximum" value="5" />
	<add key="Y.Parking" value="2.5" />
	<add key="Y.Polarity" value="1" />
	<add key="Y.StepSize" value="0.1" />
	<add key="Z.Minimum" value="0" />
	<add key="Z.Maximum" value="4.8" />
	<add key="Z.Polarity" value="1" />
	<add key="Z.StepSize" value="0.1" />
	<add key="Global.StartZ" value="3.8" />

	<!-- Imaging parameters -->
	<add key="LineCamera.Height" value="1000" />
	<add key="LineCamera.OffsetX" value="210" />
	<add key="LineCamera.OffsetY" value="0" />
	<add key="LineCamera.Width" value="1700" />
	<add key="ROI.Height" value="1200" />
	<add key="ROI.OffsetX" value="0" />
	<add key="ROI.OffsetY" value="0" />
	<add key="ROI.Width" value="1400" />

	<add key="SystemPreparation.dryMinimumPeakMedianIntensityThreshold" value="0.5" />
	<add key="SystemPreparation.WetMinimumLeftPeakMedianIntensityThreshold" value="2000" />
	<add key="SystemPreparation.WetMinimumRightPeakMedianIntensityThreshold" value="50" />
	<add key="WaterDetection.minimumLeftPeakMedianIntensityThreshold" value="200" />
	<add key="WaterDetection.minimumRightPeakMedianIntensityThreshold" value="50" />

	<add key="OctoPlus.LinePeriod" value="5012" />
	<add key="OctoPlus.Exposure" value="4930" />
	<!-- trigger mode options: Internal, ExternalFrame, ExternalFrameFullExposure, ExternalLine, ExternalLineFullExposure, ExternalMixed-->
	<add key="OctoPlus.TriggerMode" value="ExternalLine" /><!-- 16.12.2025 -->
	<add key="LineCamera.ExternalTriggerPeriodInuSec" value="50.125" />
	<add key="LineCamera.ExternalTriggerLinesNumInFrame" value="1000" />
	<add key="waterDetectionIntervalLength" value="1.0" />
	<add key="SpaceMouse.Enabled" value="TRUE" />
	<add key="SpaceMouse.FocusSensitivity" value="450000" />
	<add key="SpaceMouse.StageSensitivity" value="40000" />
	<add key="LineCamera.AnalogGain" value="1" />
	<add key="XyLocking.ShiftDB" value="C:\Users\Oleg\source\repos\LiteBC\HemoScope\HemoScope\bin\Data\stab_shifts_100k1.csv"/>

	<add key='DepthOfFocus' value='16' />
	<add key='XyLocking.FrameSelectionRate' value='8' />
	
	<!-- Led Controller settings: LedController.Device and LedController.Channels are now part of
	     Arduino.Pins (Controller / ControllerChannel and the power fields, per pin). -->
</appSettings>
